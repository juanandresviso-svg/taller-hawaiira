NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Gmail exclusivo del taller (resumen diario de alertas)
# La contraseña de aplicación se crea en myaccount.google.com/apppasswords (16 letras)
GMAIL_USER=tallerhawaiira@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM_NAME=Taller Hawaiira

# Clave inventada por ti para proteger el resumen diario (Vercel la usa sola)
CRON_SECRET=una-clave-larga-y-aleatoria

# Notificaciones push: se generan en la app → Notificaciones → Generar claves (instructivo, paso 4.5)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tallerhawaiira@gmail.com

# Opcional. Si lo dejas vacío, la app usa sola su dirección de Vercel (xxxx.vercel.app)
# NEXT_PUBLIC_SITE_URL=

# Google Drive: documentos de cada pedido y hoja de seguimiento (instructivo, paso 4.6)
